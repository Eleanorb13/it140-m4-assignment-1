# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode

START hilow_game

    # Establish a valid guessing range.
    GET lower_bound
    GET upper_bound

    WHILE lower_bound >= upper_bound
        PUT "The lower bound must be less than the upper bound."
        GET lower_bound
        GET upper_bound
    ENDWHILE

    # Establish the number the player is trying to guess.
    LET random_number = RANDOM number between lower_bound and upper_bound

    # Play the game.
    PUT "Guess a number between", lower_bound, "and", upper_bound
    GET guess

    WHILE guess < lower_bound OR guess > upper_bound
        PUT "Please enter a number between", lower_bound, "and", upper_bound
        GET guess
    ENDWHILE

    WHILE guess != random_number

        IF guess < random_number
            PUT "Nope, too low."
        ELSE
            PUT "Nope, too high."
        ENDIF

        PUT "Guess another number."
        GET guess

        WHILE guess < lower_bound OR guess > upper_bound
            PUT "Please enter a number between", lower_bound, "and", upper_bound
            GET guess
        ENDWHILE

    ENDWHILE

    PUT "You got it!"

END hilow_game
